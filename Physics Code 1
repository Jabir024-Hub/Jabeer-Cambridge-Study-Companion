function finishPractice(){addXP(5);const topic=document.getElementById("practiceTopic").value,pct=Math.round(practice.score/practice.questions.length*100);if(pct>=80&&!state.mastered.includes(topic)){state.mastered.push(topic);addXP(10);alert(`🏆 TOPIC MASTERED!\n${practice.score}/${practice.questions.length}\n${pct}%\n+5 XP Practice\n+10 XP Mastery Bonus`);}else alert(`🎉 Practice complete!\n${practice.score}/${practice.questions.length}\n${pct}%\n+5 XP`);save();renderMap();document.getElementById("practiceSetup").classList.remove("hidden");document.getElementById("practiceQuiz").classList.add("hidden");}
function startChallenge(){const topic=document.getElementById("challengeTopic").value;challenge.topic=topic;challenge.questions=getQuestions(topic,25).map(randomizeQuestion);challenge.position=0;challenge.score=0;if(!challenge.questions.length)return alert("No questions available for this topic yet.");document.getElementById("challengeSetup").classList.add("hidden");document.getElementById("challengeQuiz").classList.remove("hidden");renderChallenge();}
function renderChallenge(){const q=challenge.questions[challenge.position],total=challenge.questions.length;markSeen(q);document.getElementById("challengeCounter").textContent=`Question ${challenge.position+1} / ${total}`;document.getElementById("challengeScore").textContent=`${challenge.score} correct`;document.getElementById("challengeBar").style.width=`${challenge.position/total*100}%`;document.getElementById("challengeQuestion").textContent=q.q;document.getElementById("challengeFeedback").textContent="";document.getElementById("challengeNext").classList.add("hidden");const root=document.getElementById("challengeAnswers");root.innerHTML="";q.answers.forEach((choice,i)=>{const b=document.createElement("button");b.className="answer";b.textContent=choice.text;b.onclick=()=>answerChallenge(i,b);root.appendChild(b);});challenge.answered=false;}
function answerChallenge(i,b){if(challenge.answered)return;challenge.answered=true;const q=challenge.questions[challenge.position];state.answered++;if(i===q.correct){challenge.score++;state.correct++;b.classList.add("correct");document.getElementById("challengeFeedback").textContent="✅ Correct!";}else{b.classList.add("wrong");const correct=q.answers[q.correct].text;document.querySelectorAll("#challengeAnswers .answer").forEach(x=>{if(x.textContent===correct)x.classList.add("correct")});document.getElementById("challengeFeedback").textContent=`❌ Correct answer: ${correct}`;}save();updateUI();document.getElementById("challengeNext").classList.remove("hidden");}
function nextChallenge(){challenge.position++;if(challenge.position>=challenge.questions.length)finishChallenge();else renderChallenge();}
function finishChallenge(){const total=challenge.questions.length,pct=Math.round(challenge.score/total*100);addXP(25);if(pct>=80&&!state.mastered.includes(challenge.topic)){state.mastered.push(challenge.topic);addXP(10);alert(`🏆 Topic mastered!\n${challenge.score}/${total} (${pct}%)\n+25 XP Challenge\n+10 XP Mastery Bonus`);}else alert(`🎉 Challenge complete!\n${challenge.score}/${total} (${pct}%)\n+25 XP`);save();renderMap();document.getElementById("challengeSetup").classList.remove("hidden");document.getElementById("challengeQuiz").classList.add("hidden");}
function renderFormulas(){const root=document.getElementById("formulaGrid");root.innerHTML="";FORMULAS.forEach(f=>{const c=document.createElement("div");c.className="formula";c.innerHTML=`<small>${f[0]}</small><h3>${f[1]}</h3><h2>${f[2]}</h2><p>${f[3]}</p>`;root.appendChild(c);});}
function renderMastery(){const overall=Math.round(state.mastered.length/TOPICS.length*100);document.getElementById("masteryPercent").textContent=`${overall}%`;document.getElementById("masteryBar").style.width=`${overall}%`;const root=document.getElementById("masteryList");root.innerHTML="";TOPICS.forEach((t,i)=>{const pct=state.mastered.includes(t)?100:state.lessons.includes(t)?50:0;const r=document.createElement("div");r.className="mastery-item";r.innerHTML=`<div class="mastery-top"><span>${i+1}. ${t}</span><span>${pct}%</span></div><div class="bar"><div style="width:${pct}%"></div></div>`;root.appendChild(r);});}
function updateUI(){updateStudyDay();document.getElementById("xp").textContent=state.xp;document.getElementById("dailyXP").textContent=state.dailyXP;document.getElementById("streak").textContent=state.streak;document.getElementById("dailyProgress").style.width=`${state.dailyXP*2}%`;const mastery=Math.round(state.mastered.length/TOPICS.length*100);document.getElementById("homePhysicsBar").style.width=`${mastery}%`;document.getElementById("statXP").textContent=state.xp;document.getElementById("statStreak").textContent=state.streak;document.getElementById("statQuestions").textContent=state.answered;document.getElementById("statAccuracy").textContent=`${state.answered?Math.round(state.correct/state.answered*100):0}%`;}
function init(){updateStudyDay();populateSelectors();renderFormulas();renderMap();updateUI();}
init();

